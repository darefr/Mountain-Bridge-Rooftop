# ---------------------------------------------------------------------------
# Gmail SMTP — required for REAL email verification & password-reset delivery
# ---------------------------------------------------------------------------
# Add these in Vercel → Project → Settings → Environment Variables
# (Production, Preview, and Development as needed). These are SERVER-ONLY.
# Never prefix any of them with NEXT_PUBLIC_ and never commit real values.
#
# SMTP_PASS must be a Gmail APP PASSWORD (16 characters), NOT your normal
# Gmail account password. The Gmail account must have 2-Step Verification
# enabled and an App Password generated at https://myaccount.google.com/apppasswords
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=YOUR_GMAIL_ADDRESS

# ---------------------------------------------------------------------------
# Durable storage (Vercel Blob) — recommended in production so that users,
# verification codes, bookings, etc. persist across serverless instances.
# Without it, data lives only in the memory of a single instance.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=
